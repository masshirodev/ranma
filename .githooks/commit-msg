#!/usr/bin/env sh

# Reject commits containing Co-Authored-By trailers, Claude-Session references,
# or robot emoji (🤖).
#
# Skip flags (set to any non-empty value):
#   SKIP_COAUTHOR SKIP_EMOJI SKIP_ALL

RED='\033[0;31m'
BOLD='\033[1m'
RESET='\033[0m'

fail() { printf "${RED}${BOLD}[fail] %s${RESET}\n" "$1" >&2; }
hint() { printf "${RED}       %s${RESET}\n" "$1" >&2; }

if [ -n "$SKIP_ALL" ]; then
	exit 0
fi

if [ -z "$1" ] || [ ! -f "$1" ]; then
	exit 0
fi

FAILED=0

if [ -z "$SKIP_COAUTHOR" ] && grep -v '^[[:space:]]*#' "$1" | grep -qEi '^[[:space:]]*co-?author(ed)?(-by)?:'; then
	printf "\n" >&2
	fail "Co-authored commits are not allowed in this repository."
	hint "Please remove any Co-Authored-By / Co-author trailers and try again."
	FAILED=1
fi

if grep -v '^[[:space:]]*#' "$1" | grep -qiE 'claude-session[[:space:]]*:'; then
	[ "$FAILED" -eq 0 ] && printf "\n" >&2
	fail "Claude-Session is not allowed in commit messages."
	hint "Please remove any Claude-Session references and try again."
	FAILED=1
fi

if grep -v '^[[:space:]]*#' "$1" | grep -q '🤖'; then
	[ "$FAILED" -eq 0 ] && printf "\n" >&2
	fail "Robot emoji (🤖) is not allowed in commit messages."
	hint "Please remove any 🤖 emoji and try again."
	FAILED=1
fi

# Any emoji, not only the robot (~/AGENTS.md: no emoji in commit messages).
# Unicode's own Extended_Pictographic, minus the text symbols it also counts
# (copyright, registered, trade mark, info, the plain arrows), so a commit
# that writes (c) or an arrow is not refused. Needs a grep with -P; one
# without it skips the check rather than refusing every commit.
EMOJI='(?![\x{00A9}\x{00AE}\x{203C}\x{2049}\x{2122}\x{2139}\x{2194}-\x{2199}])\p{Extended_Pictographic}'
if [ -z "$SKIP_EMOJI" ] && printf 'x' | grep -qP 'x' 2>/dev/null &&
	grep -v '^[[:space:]]*#' "$1" | grep -qP "$EMOJI"; then
	[ "$FAILED" -eq 0 ] && printf "\n" >&2
	fail "Emoji are not allowed in commit messages."
	hint "Found: $(grep -v '^[[:space:]]*#' "$1" | grep -oP "$EMOJI" | head -3 | tr -d '\n')"
	FAILED=1
fi

if [ "$FAILED" -ne 0 ]; then
	printf "\n" >&2
	exit 1
fi
